---
// Layout base: o "template" que toda página usa (como um layout do Thymeleaf).
// Cuida do <head>, das fontes, do header, do footer e do botão fixo de WhatsApp.
// Fases seguintes adicionam aqui: SEO completo/Open Graph (fase 8), GTM e cookies (fase 7).

// Fontes self-hosted (Fontsource): o build copia os arquivos para o site, sem Google Fonts.
import '@fontsource/alice/400.css';
import '@fontsource-variable/josefin-sans/index.css';
import '../styles/tokens.css';
import '../styles/global.css';

import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppFixo from '../components/layout/WhatsAppFixo.astro';
import TransicaoPagina from '../components/layout/TransicaoPagina.astro';
import { site } from '../config/site';
import type { RastreioWhatsApp } from '../lib/whatsapp';

interface Props {
  titulo?: string;
  descricao?: string;
  mostrarWhatsAppFixo?: boolean; // false em Contato e Links, que já têm o WhatsApp no topo
  mensagemWhatsApp?: string;
  mostrarHeader?: boolean; // false na página de Links (bio), que é "limpa"
  mostrarFooter?: boolean;
  naoIndexar?: boolean; // pede ao Google para não listar a página (ex.: /obrigado)
  rastreioWhatsApp?: RastreioWhatsApp; // contexto do clique no botão fixo (projeto, serviço...)
}

const {
  titulo,
  descricao = site.descricao,
  mostrarWhatsAppFixo = true,
  mensagemWhatsApp,
  mostrarHeader = true,
  mostrarFooter = true,
  naoIndexar = false,
  rastreioWhatsApp,
} = Astro.props;

const tituloCompleto = titulo ? `${titulo} | ${site.nome}` : site.nome;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    {naoIndexar && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <TransicaoPagina />
    <a class="pular-conteudo" href="#conteudo">Pular para o conteúdo</a>
    {mostrarHeader && <Header />}
    <main id="conteudo">
      <slot />
    </main>
    {mostrarFooter && <Footer />}
    {mostrarWhatsAppFixo && <WhatsAppFixo mensagem={mensagemWhatsApp} rastreio={rastreioWhatsApp} />}
  </body>
</html>

<script>
  // Origem da visita (UTMs) + evento de clique no WhatsApp, em todas as páginas
  import '../scripts/conversao';
</script>

<style>
  /* Link de acessibilidade: só aparece quando recebe foco pelo teclado */
  .pular-conteudo {
    position: absolute;
    left: var(--esp-3);
    top: -100px;
    z-index: 100;
    padding: var(--esp-2) var(--esp-3);
    background: var(--cor-principal);
    color: var(--cor-branco);
  }
  .pular-conteudo:focus {
    top: var(--esp-3);
  }
</style>

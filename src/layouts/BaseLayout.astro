---
// Layout base: o "template" que toda página usa (como um layout do Thymeleaf).
// Cuida do <head>, das fontes, do header, do footer e do botão fixo de WhatsApp.
// Fases seguintes adicionam aqui: GTM e cookies (fase 7).
//
// Prévia de link (Open Graph, fase 8): é o "cartãozinho" com foto, título e descrição que aparece
// quando alguém manda o link no WhatsApp, Instagram, Facebook, LinkedIn...
// - A foto é a `imagem` que a página passar (ex.: a capa do projeto); sem isso, a primeira foto
//   do slideshow da home. O build recorta em 1200 × 630 (o formato que essas redes usam).
// - Os endereços precisam ser completos (com domínio). Ver `urlTeste` e `emConstrucao` em site.ts.
import { getImage } from 'astro:assets';
import { slidesHero } from '../config/home';

// Fontes self-hosted (Fontsource): o build copia os arquivos para o site, sem Google Fonts.
import '@fontsource/alice/400.css';
import '@fontsource-variable/josefin-sans/index.css';
import '../styles/tokens.css';
import '../styles/global.css';

import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppFixo from '../components/layout/WhatsAppFixo.astro';
import TransicaoPagina from '../components/layout/TransicaoPagina.astro';
import { site } from '../config/site';
import type { RastreioWhatsApp } from '../lib/whatsapp';

interface Props {
  titulo?: string;
  descricao?: string;
  mostrarWhatsAppFixo?: boolean; // false em Contato e Links, que já têm o WhatsApp no topo
  mensagemWhatsApp?: string;
  mostrarHeader?: boolean; // false na página de Links (bio), que é "limpa"
  mostrarFooter?: boolean;
  naoIndexar?: boolean; // pede ao Google para não listar a página (ex.: /obrigado)
  rastreioWhatsApp?: RastreioWhatsApp; // contexto do clique no botão fixo (projeto, serviço...)
  detalheWhatsApp?: string; // segunda linha do botão fixo (ex.: serviço escolhido)
  imagem?: ImageMetadata; // foto da prévia de link (padrão: a primeira do slideshow da home)
  imagemAlt?: string;
}

const {
  titulo,
  descricao = site.descricao,
  mostrarWhatsAppFixo = true,
  mensagemWhatsApp,
  mostrarHeader = true,
  mostrarFooter = true,
  naoIndexar = false,
  rastreioWhatsApp,
  detalheWhatsApp,
  imagem = slidesHero[0].imagem,
  imagemAlt = slidesHero[0].alt,
} = Astro.props;

const tituloCompleto = titulo ? `${titulo} | ${site.nome}` : site.nome;

// Prévia de link: endereço completo da página e da foto (recortada em 1200 × 630)
const enderecoBase = site.emConstrucao ? site.urlTeste : site.url;
const enderecoPagina = new URL(Astro.url.pathname, enderecoBase).href;
const fotoPrevia = await getImage({ src: imagem, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const enderecoFoto = new URL(fotoPrevia.src, enderecoBase).href;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    {(naoIndexar || site.emConstrucao) && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={enderecoPagina} />

    <!-- Prévia de link (WhatsApp, Instagram, Facebook, LinkedIn, X) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={enderecoPagina} />
    <meta property="og:image" content={enderecoFoto} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imagemAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <TransicaoPagina />
    <a class="pular-conteudo" href="#conteudo">Pular para o conteúdo</a>
    {mostrarHeader && <Header />}
    <main id="conteudo">
      <slot />
    </main>
    {mostrarFooter && <Footer />}
    {
      mostrarWhatsAppFixo && (
        <WhatsAppFixo mensagem={mensagemWhatsApp} rastreio={rastreioWhatsApp} detalhe={detalheWhatsApp} />
      )
    }
  </body>
</html>

<script>
  // Origem da visita (UTMs) + evento de clique no WhatsApp, em todas as páginas
  import '../scripts/conversao';
</script>

<style>
  /* Link de acessibilidade: só aparece quando recebe foco pelo teclado */
  .pular-conteudo {
    position: absolute;
    left: var(--esp-3);
    top: -100px;
    z-index: 100;
    padding: var(--esp-2) var(--esp-3);
    background: var(--cor-principal);
    color: var(--cor-branco);
  }
  .pular-conteudo:focus {
    top: var(--esp-3);
  }
</style>

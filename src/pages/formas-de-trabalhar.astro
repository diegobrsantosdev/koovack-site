---
// Formas de trabalhar: os 4 serviços em detalhe (sem valores), o FAQ e a chamada para o WhatsApp.
// Os cards são SELECIONÁVEIS (componente SeletorServicos): o "Recomendado" vem marcado e os botões
// de WhatsApp da página (fixo na base, o bloco abaixo dos cards no desktop e o do fim) pedem
// orçamento do serviço escolhido.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CabecalhoPagina from '../components/ui/CabecalhoPagina.astro';
import Secao from '../components/ui/Secao.astro';
import SeletorServicos from '../components/servicos/SeletorServicos.astro';
import FAQ from '../components/servicos/FAQ.astro';
import BotaoWhatsApp from '../components/ui/BotaoWhatsApp.astro';
import { mensagemServico } from '../lib/whatsapp';

const servicos = (await getCollection('servicos')).sort((a, b) => a.data.ordem - b.data.ordem);
const nomePadrao = (servicos.find((s) => s.data.recomendado) ?? servicos[0]).data.nome;
---

<BaseLayout
  titulo="Formas de trabalhar"
  descricao="Consultoria, projeto de um ambiente, projeto completo e projetos comerciais. Atendimento em Recife e online para todo o Brasil."
  mensagemWhatsApp={mensagemServico(nomePadrao)}
  rastreioWhatsApp={{ servico: nomePadrao }}
  detalheWhatsApp={nomePadrao}
>
  <CabecalhoPagina
    titulo="Escolha como começar"
    intro="Do ajuste de um ambiente ao projeto completo. Atendimento em Recife e online para todo o Brasil."
  />

  <div class="container servicos">
    <!-- Celular: o botão fixo da base mostra a escolha. Desktop: bloco logo abaixo dos cards. -->
    <SeletorServicos colunas={2} blocoNoCelular={false} atualizarBotaoFixo />
  </div>

  <Secao titulo="Perguntas frequentes" fundo="alt">
    <FAQ pagina="formas-de-trabalhar" />
  </Secao>

  <Secao>
    <div class="chamada">
      <h2>Quer saber valores e prazos?</h2>
      <p>
        Cada projeto é orçado conforme o tamanho e o escopo. Me chame no WhatsApp para{' '}
        <strong data-servico-escolhido>{nomePadrao}</strong> e eu explico.
      </p>
      <BotaoWhatsApp mensagem={mensagemServico(nomePadrao)} rastreio={{ servico: nomePadrao }} dinamico />
    </div>
  </Secao>

  <!-- Só no fim, depois de todo o conteúdo do cliente final: caminho para o serviço B2B -->
  <section class="escritorios">
    <div class="container escritorios__dentro">
      <p class="escritorios__rotulo">Para escritórios de arquitetura</p>
      <p>Também faço renders realistas a partir do seu modelo 3D.</p>
      <a href="/renderizacao">Conheça a renderização →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .servicos {
    padding-block: var(--esp-2) var(--esp-8);
  }
  .chamada {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--esp-4);
    text-align: center;
  }
  .chamada h2 {
    font-size: clamp(1.375rem, 1.1rem + 1.2vw, 2.125rem);
  }
  .chamada strong {
    font-weight: 600;
  }

  /* Faixa discreta para escritórios (fim da página) */
  .escritorios {
    padding-block: var(--esp-6);
    border-top: 1px solid var(--cor-filete);
    background: var(--cor-fundo-alt);
  }
  .escritorios__dentro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--esp-2);
    text-align: center;
  }
  .escritorios__rotulo {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    opacity: 0.75;
  }
  .escritorios a {
    font-size: var(--texto-pequeno);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-underline-offset: 0.3em;
  }
</style>

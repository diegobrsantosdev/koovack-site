---
// Página Sobre: foto + nome → história → especialidades e ferramentas → chamada para o WhatsApp.
// Texto reescrito em 23/11/2026, mais profissional e SEM os "4 anos de estágio" (pedido do Diego).
// Só usa o que o próprio Diogo disse/publicou: veio da História, arquiteto e urbanista em Recife,
// foco em arquitetura de interiores, gera imagens e vídeos (renderização). REVISAR COM ELE.
// A seção "Bastidores" volta quando houver fotos do processo (croquis, maquetes, obra).
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Secao from '../components/ui/Secao.astro';
import ChamadaFinal from '../components/home/ChamadaFinal.astro';
import { sobreResumo } from '../config/home';

// O que o Diogo faz (fonte: o que ele mesmo descreveu em 23/11/2026). REVISAR COM ELE.
const especialidades = [
  'Arquitetura residencial',
  'Espaços comerciais',
  'Arquitetura de interiores',
  'Modelagem 3D',
  'Renderização realista',
  'Vídeos e animações',
];
// Ferramentas que o Diogo usa (fonte: documento de contexto)
const ferramentas = ['AutoCAD', 'Revit', 'SketchUp', 'Layout', 'Enscape'];
---

<BaseLayout
  titulo="Sobre"
  descricao="Diogo Koovack, arquiteto e urbanista em Recife. Projetos de arquitetura e interiores para todo o Brasil."
  imagem={sobreResumo.fotoPrevia}
  imagemAlt={sobreResumo.alt}
>
  <section class="container topo">
    <Picture
      class="topo__foto"
      src={sobreResumo.foto}
      alt={sobreResumo.alt}
      formats={['avif', 'webp']}
      widths={[400, 700, 900, 1200]}
      sizes="(min-width: 56rem) 26rem, 100vw"
      loading="eager"
    />
    <div class="topo__texto">
      <h1>Diogo Koovack</h1>
      <p class="topo__cargo">Arquiteto e urbanista</p>
      <p>
        Sou arquiteto e urbanista em Recife, com foco em arquitetura de interiores. Acredito que um bom
        projeto começa por entender quem vai viver o espaço. Desenvolvo projetos para casas,
        apartamentos e espaços comerciais, em Recife e em todo o Brasil.
      </p>
    </div>
  </section>

  <Secao titulo="Minha história" fundo="alt">
    <div class="prosa">
      <p>
        Cheguei à arquitetura pela História. O olhar para as pessoas, a cidade e o tempo continua
        presente na forma como projeto: espaços que fazem sentido para quem vive neles, com identidade
        e atenção a cada detalhe.
      </p>
      <p>
        Hoje meu trabalho une projeto e imagem. Desenvolvo a arquitetura e os interiores e também
        produzo os renders e vídeos realistas que mostram, antes da obra, como cada ambiente vai ficar.
        Assim, as decisões são tomadas com clareza e segurança, do primeiro estudo à entrega.
      </p>
    </div>
  </Secao>

  <Secao titulo="Especialidades e ferramentas">
    <div class="habilidades">
      <ul class="ferramentas" aria-label="Especialidades">
        {especialidades.map((e) => <li>{e}</li>)}
      </ul>
      <ul class="ferramentas ferramentas--programas" aria-label="Ferramentas">
        {ferramentas.map((f) => <li>{f}</li>)}
      </ul>
    </div>
  </Secao>

  <Secao fundo="alt">
    <ChamadaFinal texto="Me conte sobre o seu projeto. Atendo em Recife e em todo o Brasil." />
  </Secao>
</BaseLayout>

<style>
  .topo {
    display: grid;
    gap: var(--esp-5);
    align-items: center;
    padding-block: var(--esp-6) var(--esp-7);
  }
  .topo :global(.topo__foto) {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }
  .topo__texto {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--esp-3);
    max-width: 34rem;
  }
  .topo__cargo {
    margin-top: calc(var(--esp-2) * -1);
    font-size: var(--texto-pequeno);
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }
  @media (min-width: 56rem) {
    .topo {
      grid-template-columns: 26rem 1fr;
      gap: var(--esp-7);
    }
  }

  .prosa {
    display: flex;
    flex-direction: column;
    gap: var(--esp-3);
    max-width: 40rem;
  }

  .habilidades {
    display: flex;
    flex-direction: column;
    gap: var(--esp-4);
  }
  /* Programas: mesmo formato das especialidades, mais discretos (contorno tracejado) */
  .ferramentas--programas li {
    border-style: dashed;
    opacity: 0.85;
  }
  .ferramentas {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-2);
  }
  .ferramentas li {
    padding: var(--esp-2) var(--esp-4);
    border: 1px solid var(--cor-filete);
    border-radius: var(--raio-botao);
    font-size: var(--texto-pequeno);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
</style>

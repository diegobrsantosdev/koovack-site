---
// Página de renderização para escritórios de arquitetura, designers e construtoras (B2B).
// ESQUELETO (23/11/2026): textos e valores provisórios em src/config/renderizacao.ts.
// Público: arquitetos e escritórios, NÃO o cliente final. Por isso o topo diz "Para arquitetos e
// escritórios". Tem item próprio no menu, linha no rodapé, faixa no fim de Formas de trabalhar e
// botão na página da bio (/links). Usa o layout normal do site (header, menu e rodapé).
// Ordem: promessa → modelo × render → nossas entregas → pacotes (cards selecionáveis, como em
// Formas de trabalhar) → como funciona → projetos → perguntas → orçamento (WhatsApp + formulário).
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Secao from '../components/ui/Secao.astro';
import Etiqueta from '../components/ui/Etiqueta.astro';
import BotaoWhatsApp from '../components/ui/BotaoWhatsApp.astro';
import ComparadorPlantaRender from '../components/case/ComparadorPlantaRender.astro';
import CarrosselProjetos from '../components/projetos/CarrosselProjetos.astro';
import ComoFunciona from '../components/home/ComoFunciona.astro';
import FAQ from '../components/servicos/FAQ.astro';
import SeletorServicos from '../components/servicos/SeletorServicos.astro';
import FormContato from '../components/forms/FormContato.astro';
import { projetosOrdenados } from '../lib/projetos';
import { renderizacao as r } from '../config/renderizacao';

const rastreio = { campanha: 'renderizacao' };

const projetos = await projetosOrdenados();
---

<BaseLayout
  titulo="Renderização"
  descricao={r.subtitulo}
  mensagemWhatsApp={r.mensagemWhatsApp}
  rastreioWhatsApp={rastreio}
>
  <!-- Topo: render + promessa -->
  <section class="topo" data-esconde-whatsapp-fixo>
    <Picture
      class="topo__img"
      src={r.hero.imagem}
      alt={r.hero.alt}
      formats={['avif', 'webp']}
      widths={[480, 800, 1200, 1920, 2560]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="topo__sombra" aria-hidden="true"></div>
    <div class="container topo__conteudo">
      <div class="topo__etiquetas">
        <Etiqueta variante="solida">{r.publico}</Etiqueta>
        {r.provisorio && <span class="topo__provisorio"><Etiqueta>Conteúdo provisório</Etiqueta></span>}
      </div>
      <h1>{r.titulo}</h1>
      <p class="topo__subtitulo">{r.subtitulo}</p>
      <div class="topo__botoes">
        <BotaoWhatsApp mensagem={r.mensagemWhatsApp} rastreio={rastreio} />
        <a class="topo__link" href="#pacotes">Ver pacotes</a>
      </div>
    </div>
  </section>

  <Secao titulo="Do modelo ao render" subtitulo="Arraste a linha para comparar a tela do modelo 3D com a imagem final.">
    <div class="antes-depois" data-abas>
      <div class="antes-depois__abas" role="group" aria-label="Escolha o ambiente">
        {
          r.comparacoes.map((c, i) => (
            <button type="button" class="aba" aria-pressed={i === 0 ? 'true' : 'false'} data-aba={i}>
              {c.nome}
            </button>
          ))
        }
      </div>
      {
        r.comparacoes.map((c, i) => (
          <div class="antes-depois__painel" data-painel={i} hidden={i !== 0}>
            <ComparadorPlantaRender planta={c.modelo} render={c.render} rotuloReferencia="Modelo 3D" largo />
          </div>
        ))
      }
    </div>
  </Secao>

  <Secao titulo="Nossas entregas" fundo="alt">
    <ul class="lista-tres">
      {
        r.entregas.map((s) => (
          <li class="item">
            <h3>{s.titulo}</h3>
            <p>{s.texto}</p>
          </li>
        ))
      }
    </ul>
  </Secao>

  <Secao titulo="Pacotes" id="pacotes">
    <p class="nota">{r.notaPacotes}</p>
    <SeletorServicos
      opcoes={r.pacotes}
      modeloMensagem={r.mensagemPacote}
      legenda="Escolha um pacote"
      colunas={2}
    />
  </Secao>

  <Secao titulo="Como funciona" fundo="alt">
    <ComoFunciona passos={r.passos} />
  </Secao>

  {
    projetos.length > 0 && (
      <Secao titulo="Projetos renderizados" fundo="alt">
        <CarrosselProjetos projetos={projetos} rotulo="Projetos renderizados" />
      </Secao>
    )
  }

  <Secao titulo="Perguntas frequentes">
    <FAQ pagina="renderizacao" />
  </Secao>

  <Secao titulo="Peça seu orçamento" fundo="alt" id="orcamento">
    <div class="orcamento">
      <div class="orcamento__whatsapp">
        <p>O jeito mais rápido é pelo WhatsApp:</p>
        <BotaoWhatsApp mensagem={r.mensagemWhatsApp} rastreio={rastreio} />
      </div>
      <div class="orcamento__form">
        <p>Ou deixe seus dados que eu entro em contato:</p>
        <FormContato
          variante="renderizacao"
          campanha="renderizacao"
          tipoProjeto="Renderização"
          textoBotao="Quero meu orçamento"
        />
      </div>
    </div>
  </Secao>
</BaseLayout>

<script>
  // Abas do "Do modelo ao render": mostra o comparador do ambiente escolhido.
  document.querySelectorAll<HTMLElement>('[data-abas]').forEach((bloco) => {
    const abas = [...bloco.querySelectorAll<HTMLButtonElement>('[data-aba]')];
    const paineis = [...bloco.querySelectorAll<HTMLElement>('[data-painel]')];
    abas.forEach((aba) =>
      aba.addEventListener('click', () => {
        abas.forEach((a) => a.setAttribute('aria-pressed', String(a === aba)));
        paineis.forEach((p) => (p.hidden = p.dataset.painel !== aba.dataset.aba));
      }),
    );
  });
</script>

<style>
  /* Do modelo ao render: abas em pílula + comparador grande */
  .antes-depois {
    display: flex;
    flex-direction: column;
    gap: var(--esp-4);
  }
  .antes-depois__abas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-2);
  }
  .aba {
    min-height: 2.75rem;
    padding: var(--esp-1) var(--esp-4);
    border: 1px solid var(--cor-principal);
    border-radius: var(--raio-botao);
    background: transparent;
    color: var(--cor-principal);
    font: inherit;
    font-size: var(--texto-pequeno);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition: background-color var(--transicao), color var(--transicao);
  }
  .aba[aria-pressed='true'] {
    background: var(--cor-principal);
    color: var(--cor-branco);
  }

  /* Topo com render de fundo e promessa por cima (mesmo visual das landing pages) */
  .topo {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: calc(88svh - var(--altura-header));
    color: var(--cor-branco);
    background: #222;
    overflow: hidden;
  }
  .topo :global(picture) {
    position: absolute;
    inset: 0;
  }
  .topo :global(.topo__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .topo__sombra {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.7) 0%, rgb(0 0 0 / 0.3) 50%, transparent 80%);
  }
  .topo__conteudo {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--esp-3);
    padding-block: var(--esp-7) var(--esp-6);
  }
  .topo__etiquetas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-2);
  }
  .topo__provisorio {
    color: var(--cor-branco);
  }
  .topo h1 {
    color: var(--cor-branco);
    max-width: 20ch;
    font-size: clamp(1.75rem, 1.2rem + 2.8vw, 3.25rem);
  }
  .topo__subtitulo {
    max-width: 36rem;
    font-size: var(--texto-grande);
    font-weight: 300;
  }
  .topo__botoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--esp-3) var(--esp-4);
    margin-top: var(--esp-2);
  }
  .topo__link {
    font-size: var(--texto-pequeno);
    text-underline-offset: 0.3em;
  }
  .topo :global(:focus-visible) {
    outline-color: var(--cor-branco);
  }

  /* Nossas entregas (3 itens) */
  .lista-tres {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--esp-5);
  }
  .item {
    display: flex;
    flex-direction: column;
    gap: var(--esp-2);
    padding-top: var(--esp-4);
    border-top: 1px solid var(--cor-detalhe);
  }
  .item h3 {
    font-size: var(--texto-grande);
    letter-spacing: 0.14em;
  }
  @media (min-width: 56rem) {
    .lista-tres {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Pacotes: os cards vêm do SeletorServicos (mesmo visual de Formas de trabalhar) */
  .nota {
    max-width: 40rem;
    font-size: var(--texto-pequeno);
  }

  /* Orçamento: WhatsApp + formulário */
  .orcamento {
    display: grid;
    gap: var(--esp-6);
  }
  .orcamento__whatsapp,
  .orcamento__form {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--esp-3);
  }
  @media (min-width: 56rem) {
    .orcamento {
      grid-template-columns: 1fr 1.4fr;
      gap: var(--esp-7);
    }
  }
</style>

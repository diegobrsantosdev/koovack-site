---
// Landing page de campanha (anúncios). Uma página por arquivo em src/content/campanhas/.
// Ordem: render + promessa → o que você recebe → projetos do mesmo tipo → como funciona →
// depoimento → perguntas → formulário mínimo + WhatsApp. Fora do Google (noindex).
import { Picture } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import CampanhaLayout from '../../layouts/CampanhaLayout.astro';
import Secao from '../../components/ui/Secao.astro';
import Etiqueta from '../../components/ui/Etiqueta.astro';
import BotaoWhatsApp from '../../components/ui/BotaoWhatsApp.astro';
import Depoimento from '../../components/ui/Depoimento.astro';
import CarrosselProjetos from '../../components/projetos/CarrosselProjetos.astro';
import ComoFunciona from '../../components/home/ComoFunciona.astro';
import FAQ from '../../components/servicos/FAQ.astro';
import FormContato from '../../components/forms/FormContato.astro';
import { projetosOrdenados, ROTULO_TIPO } from '../../lib/projetos';

export async function getStaticPaths() {
  const campanhas = await getCollection('campanhas');
  return campanhas.map((campanha) => ({ params: { campanha: campanha.id }, props: { campanha } }));
}

const { campanha } = Astro.props;
const c = campanha.data;

const projetos = (await projetosOrdenados()).filter((p) => p.data.tipo === c.tipo);
const depoimento = c.depoimento ? await getEntry(c.depoimento) : undefined;
const rastreio = { campanha: campanha.id };
---

<CampanhaLayout
  titulo={c.titulo}
  descricao={c.subtitulo}
  campanha={campanha.id}
  mensagemWhatsApp={c.mensagem_whatsapp}
>
  <!-- Topo: render + promessa -->
  <section class="topo" data-esconde-whatsapp-fixo>
    <Picture
      class="topo__img"
      src={c.imagem}
      alt={c.imagem_alt}
      formats={['avif', 'webp']}
      widths={[480, 800, 1200, 1920, 2560]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="topo__sombra" aria-hidden="true"></div>
    <div class="container topo__conteudo">
      {c.provisorio && <span class="topo__provisorio"><Etiqueta>Conteúdo provisório</Etiqueta></span>}
      <h1>{c.titulo}</h1>
      <p class="topo__subtitulo">{c.subtitulo}</p>
      <div class="topo__botoes">
        <BotaoWhatsApp mensagem={c.mensagem_whatsapp} rastreio={rastreio} />
        <a class="topo__form" href="#orcamento">Prefiro preencher um formulário</a>
      </div>
    </div>
  </section>

  <Secao titulo="O que você recebe">
    <ul class="beneficios">
      {
        c.beneficios.map((b) => (
          <li class="beneficio">
            <h3>{b.titulo}</h3>
            <p>{b.texto}</p>
          </li>
        ))
      }
    </ul>
  </Secao>

  {
    projetos.length > 0 && (
      <Secao titulo={`Projetos de ${ROTULO_TIPO[c.tipo].toLowerCase()}`} fundo="alt">
        <CarrosselProjetos projetos={projetos} rotulo={`Projetos de ${ROTULO_TIPO[c.tipo]}`} />
      </Secao>
    )
  }

  <Secao titulo="Como funciona">
    <ComoFunciona />
  </Secao>

  {
    depoimento && (
      <Secao titulo="O que dizem os clientes" fundo="alt" centralizado>
        <Depoimento depoimento={depoimento.data} centralizado />
      </Secao>
    )
  }

  <Secao titulo="Perguntas frequentes">
    <FAQ pagina="campanha" />
  </Secao>

  <Secao titulo="Peça seu orçamento" fundo="alt" id="orcamento">
    <div class="orcamento">
      <div class="orcamento__whatsapp">
        <p>O jeito mais rápido é pelo WhatsApp:</p>
        <BotaoWhatsApp mensagem={c.mensagem_whatsapp} rastreio={rastreio} />
      </div>
      <div class="orcamento__form">
        <p>Ou deixe seus dados que eu entro em contato:</p>
        <FormContato
          variante="campanha"
          campanha={campanha.id}
          tipoProjeto={ROTULO_TIPO[c.tipo]}
          textoBotao="Quero meu orçamento"
        />
      </div>
    </div>
  </Secao>
</CampanhaLayout>

<style>
  /* Topo com render de fundo e promessa por cima */
  .topo {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: calc(88svh - var(--altura-header));
    color: var(--cor-branco);
    background: #222;
    overflow: hidden;
  }
  .topo :global(picture) {
    position: absolute;
    inset: 0;
  }
  .topo :global(.topo__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .topo__sombra {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.7) 0%, rgb(0 0 0 / 0.3) 50%, transparent 80%);
  }
  .topo__conteudo {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--esp-3);
    padding-block: var(--esp-7) var(--esp-6);
  }
  .topo__provisorio {
    color: var(--cor-branco);
  }
  .topo h1 {
    color: var(--cor-branco);
    max-width: 20ch;
    font-size: clamp(1.75rem, 1.2rem + 2.8vw, 3.25rem);
  }
  .topo__subtitulo {
    max-width: 36rem;
    font-size: var(--texto-grande);
    font-weight: 300;
  }
  .topo__botoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--esp-3) var(--esp-4);
    margin-top: var(--esp-2);
  }
  .topo__form {
    font-size: var(--texto-pequeno);
    text-underline-offset: 0.3em;
  }
  .topo :global(:focus-visible) {
    outline-color: var(--cor-branco);
  }

  /* O que você recebe */
  .beneficios {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--esp-5);
  }
  .beneficio {
    display: flex;
    flex-direction: column;
    gap: var(--esp-2);
    padding-top: var(--esp-4);
    border-top: 1px solid var(--cor-detalhe);
  }
  .beneficio h3 {
    font-size: var(--texto-grande);
    letter-spacing: 0.14em;
  }
  @media (min-width: 56rem) {
    .beneficios {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Orçamento: WhatsApp + formulário mínimo */
  .orcamento {
    display: grid;
    gap: var(--esp-6);
  }
  .orcamento__whatsapp,
  .orcamento__form {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--esp-3);
  }
  @media (min-width: 56rem) {
    .orcamento {
      grid-template-columns: 1fr 1.4fr;
      gap: var(--esp-7);
    }
  }
</style>

---
// Home. A ordem das seções segue o documento de contexto ("Páginas → Home").
// As faixas alternam fundo branco e cinza-claro para dar ritmo à página.
import BaseLayout from '../layouts/BaseLayout.astro';
import Secao from '../components/ui/Secao.astro';
import HeroSlideshow from '../components/home/HeroSlideshow.astro';
import FaixaAreas from '../components/home/FaixaAreas.astro';
import ComoFunciona from '../components/home/ComoFunciona.astro';
import SeletorServicos from '../components/servicos/SeletorServicos.astro';
import Depoimentos from '../components/home/Depoimentos.astro';
import SobreResumo from '../components/home/SobreResumo.astro';
import ChamadaFinal from '../components/home/ChamadaFinal.astro';
import CarrosselProjetos from '../components/projetos/CarrosselProjetos.astro';
import { projetosOrdenados } from '../lib/projetos';

const destaques = (await projetosOrdenados()).filter((p) => p.data.destaque);
---

<BaseLayout>
  <HeroSlideshow />
  <FaixaAreas />

  {
    destaques.length > 0 && (
      <Secao titulo="Projetos em destaque">
        <CarrosselProjetos projetos={destaques} rotulo="Projetos em destaque" />
        <a class="botao-contorno" href="/projetos">
          Ver todos os projetos
        </a>
      </Secao>
    )
  }

  <Secao titulo="Como funciona" fundo="alt">
    <ComoFunciona />
  </Secao>

  <Secao titulo="Formas de trabalhar comigo" subtitulo="Valores e prazos pelo WhatsApp.">
    <SeletorServicos compacto colunas={4} linkDetalhes />
  </Secao>

  <Secao titulo="O que dizem os clientes" fundo="alt" centralizado>
    <Depoimentos />
  </Secao>

  <Secao>
    <SobreResumo />
  </Secao>

  <Secao fundo="alt">
    <ChamadaFinal />
  </Secao>
</BaseLayout>

<style>
  .botao-contorno {
    align-self: center;
    display: inline-flex;
    align-items: center;
    min-height: 3.25rem;
    padding: 0 var(--esp-5);
    border: 1px solid var(--cor-principal);
    border-radius: var(--raio-botao);
    text-decoration: none;
    font-size: var(--texto-pequeno);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
  .botao-contorno:hover {
    background: var(--cor-fundo-alt);
  }
</style>

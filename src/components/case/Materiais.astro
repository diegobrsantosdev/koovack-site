---
// Materiais e paleta do projeto: círculos com a cor (ou foto do material) e o nome embaixo.
import { Image } from 'astro:assets';

interface Material {
  nome: string;
  cor?: string;
  imagem?: ImageMetadata;
}
interface Props {
  materiais: Material[];
}
const { materiais } = Astro.props;
---

<ul class="materiais">
  {
    materiais.map((m) => (
      <li class="materiais__item">
        {m.imagem ? (
          <Image class="materiais__amostra" src={m.imagem} alt="" width={160} height={160} />
        ) : (
          <span class="materiais__amostra" style={`background: ${m.cor}`} aria-hidden="true" />
        )}
        <span class="materiais__nome">{m.nome}</span>
      </li>
    ))
  }
</ul>

<style>
  .materiais {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr));
    gap: var(--esp-4) var(--esp-3);
  }
  .materiais__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--esp-2);
    text-align: center;
  }
  .materiais__amostra {
    display: block;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.08);
  }
  .materiais__nome {
    font-size: var(--texto-pequeno);
    line-height: 1.3;
  }
</style>

---
// Botão de WhatsApp para usar dentro das páginas (o fixo da base é o WhatsAppFixo).
// O texto é sempre o mesmo em todo o site; só a mensagem pré-preenchida muda.
import IconeWhatsApp from './IconeWhatsApp.astro';
import { site } from '../../config/site';
import { linkWhatsApp } from '../../lib/whatsapp';

interface Props {
  mensagem?: string;
}
const { mensagem } = Astro.props;
---

<a class="botao-whatsapp" href={linkWhatsApp(mensagem)} target="_blank" rel="noopener">
  <IconeWhatsApp />
  <span>{site.textoBotaoWhatsApp}</span>
</a>

<style>
  .botao-whatsapp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--esp-2);
    min-height: 3.25rem;
    padding: 0 var(--esp-5);
    border-radius: var(--raio-botao);
    background: var(--cor-principal);
    color: var(--cor-branco);
    text-decoration: none;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
    transition: background-color var(--transicao);
  }
  .botao-whatsapp:hover {
    background: var(--cor-principal-escura);
  }
  @media (min-width: 48rem) {
    .botao-whatsapp {
      font-size: var(--texto-pequeno);
      letter-spacing: 0.12em;
    }
  }
</style>

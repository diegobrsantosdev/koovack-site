---
// Botão de WhatsApp para usar dentro das páginas (o fixo da base é o WhatsAppFixo).
// O texto é sempre o mesmo em todo o site; só a mensagem pré-preenchida muda.
import IconeWhatsApp from './IconeWhatsApp.astro';
import { site } from '../../config/site';
import { linkWhatsApp, atributosRastreio, type RastreioWhatsApp } from '../../lib/whatsapp';

interface Props {
  mensagem?: string;
  rastreio?: RastreioWhatsApp; // contexto enviado no evento whatsapp_click
}
const { mensagem, rastreio } = Astro.props;
---

<a
  class="botao-whatsapp"
  href={linkWhatsApp(mensagem)}
  target="_blank"
  rel="noopener"
  {...atributosRastreio(rastreio)}
>
  <IconeWhatsApp />
  <span>{site.textoBotaoWhatsApp}<span class="sr-only"> {site.complementoAcessivelWhatsApp}</span></span>
</a>

<style>
  .botao-whatsapp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--esp-2);
    min-height: 3.25rem;
    max-width: 100%; /* nunca fica mais largo que o espaço disponível */
    padding: var(--esp-2) var(--esp-3); /* compacto no celular: cabe até dentro dos cards */
    border-radius: var(--raio-botao);
    background: var(--cor-principal);
    color: var(--cor-branco);
    text-decoration: none;
    text-align: center;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-wrap: balance; /* se mesmo assim não couber, quebra em 2 linhas equilibradas */
    transition: background-color var(--transicao);
  }
  .botao-whatsapp:hover {
    background: var(--cor-principal-escura);
  }
  @media (min-width: 48rem) {
    .botao-whatsapp {
      padding: var(--esp-2) var(--esp-5);
      white-space: nowrap;
      font-size: var(--texto-pequeno);
      letter-spacing: 0.12em;
    }
  }
</style>

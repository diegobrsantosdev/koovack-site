---
// Ícones das redes sociais em traço fino (decorativos: o link já tem o nome da rede).
interface Props {
  rede: 'instagram' | 'tiktok';
}
const { rede } = Astro.props;
---

<svg class="icone-rede" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {
    rede === 'instagram' ? (
      <>
        <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" />
      </>
    ) : (
      <>
        <path d="M13.5 3.5v11a3.5 3.5 0 1 1-3.5-3.5" />
        <path d="M13.5 3.5c.4 2.6 2.3 4.4 5 4.6" />
      </>
    )
  }
</svg>

<style>
  .icone-rede {
    width: 1.5rem;
    height: 1.5rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>

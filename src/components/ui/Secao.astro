---
// Seção padrão de página: espaçamento vertical, título opcional e fundo branco ou cinza-claro.
// fundo "alt" alterna as faixas da home para dar ritmo à página.
interface Props {
  titulo?: string;
  subtitulo?: string;
  fundo?: 'claro' | 'alt';
  id?: string;
}
const { titulo, subtitulo, fundo = 'claro', id } = Astro.props;
---

<section class:list={['secao', `secao--${fundo}`]} id={id}>
  <div class="container secao__dentro">
    {
      titulo && (
        <header class="secao__cabecalho">
          <h2>{titulo}</h2>
          {subtitulo && <p class="secao__subtitulo">{subtitulo}</p>}
        </header>
      )
    }
    <slot />
  </div>
</section>

<style>
  .secao {
    padding-block: var(--esp-7);
  }
  .secao--alt {
    background: var(--cor-fundo-alt);
  }
  .secao__dentro {
    display: flex;
    flex-direction: column;
    gap: var(--esp-5);
  }
  .secao__cabecalho {
    display: flex;
    flex-direction: column;
    gap: var(--esp-2);
  }
  .secao__cabecalho h2 {
    font-size: clamp(1.375rem, 1.1rem + 1.2vw, 2.125rem);
  }
  .secao__subtitulo {
    max-width: 40rem;
  }
  @media (min-width: 48rem) {
    .secao {
      padding-block: var(--esp-8);
    }
  }
</style>

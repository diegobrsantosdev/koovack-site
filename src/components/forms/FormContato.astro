---
// Formulário de contato (alternativa ao WhatsApp).
// Envia para o Web3Forms, que repassa por e-mail para koovackarquitetura@gmail.com.
// Junto vão, escondidos: a página do formulário, a página de entrada da visita e as UTMs.
// Anti-spam: "honeypot" (um campo invisível; se vier marcado, é robô e o Web3Forms descarta).
// hCaptcha opcional: só aparece se site.hcaptchaAtivo for true (desligado por padrão).
// Se a chave do Web3Forms estiver vazia (.env), o formulário mostra um aviso e não envia.
//
// Três variantes:
// - "contato" (padrão): nome, WhatsApp, cidade, tipo de projeto e mensagem (página Contato).
// - "campanha": formulário mínimo das landing pages: nome, WhatsApp, cidade e metragem.
//   O e-mail sai com o nome da campanha e o tipo de projeto já preenchidos.
// - "renderizacao": para escritórios (página /renderizacao): nome, WhatsApp, cidade e
//   "sobre o projeto" (em vez da metragem). O tipo sai fixo como "Renderização".
import { site } from '../../config/site';
import { linkWhatsApp } from '../../lib/whatsapp';

interface Props {
  variante?: 'contato' | 'campanha' | 'renderizacao';
  campanha?: string; // ex.: "apartamento" (variantes campanha e renderizacao)
  tipoProjeto?: string; // ex.: "Apartamento" (variantes campanha e renderizacao)
  textoBotao?: string;
}
const {
  variante = 'contato',
  campanha,
  tipoProjeto,
  textoBotao = 'Enviar mensagem',
} = Astro.props;

const ehCampanha = variante === 'campanha';
const ehRenderizacao = variante === 'renderizacao';
const tipos = ['Apartamento', 'Casa', 'Loja', 'Comercial', 'Outro'];
const configurado = site.web3formsChave !== '';
---

<form
  class="form"
  novalidate
  data-form-contato
  data-chave={site.web3formsChave}
  data-captcha={site.hcaptchaAtivo ? 'sim' : undefined}
  data-campanha={campanha}
  data-tipo-fixo={tipoProjeto}
  data-texto-botao={textoBotao}
>
  {
    !configurado && (
      <p class="form__aviso">
        Formulário em configuração: por enquanto ele não envia a mensagem. Use o WhatsApp.
      </p>
    )
  }

  <!-- Honeypot: invisível para pessoas; robôs costumam marcar todos os campos -->
  <input type="checkbox" name="botcheck" class="form__isca" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="campo">
    <label for="nome">Nome</label>
    <input id="nome" name="nome" type="text" autocomplete="name" maxlength="100" required />
    <p class="campo__erro">Informe seu nome.</p>
  </div>

  <div class="campo">
    <label for="whatsapp">WhatsApp</label>
    <input
      id="whatsapp"
      name="whatsapp"
      type="tel"
      inputmode="numeric"
      autocomplete="tel-national"
      placeholder="(81) 99999-9999"
      pattern="\(\d{2}\) \d{4,5}-\d{4}"
      required
      data-mascara-telefone
    />
    <p class="campo__erro">Informe um WhatsApp com DDD, ex.: (81) 99999-9999.</p>
  </div>

  <div class="campo">
    <label for="cidade">Cidade</label>
    <input id="cidade" name="cidade" type="text" autocomplete="address-level2" maxlength="80" required />
    <p class="campo__erro">Informe sua cidade.</p>
  </div>

  {
    ehCampanha ? (
      <div class="campo">
        <label for="metragem">
          Metragem aproximada <span class="campo__opcional">(m²)</span>
        </label>
        <input
          id="metragem"
          name="metragem"
          type="number"
          inputmode="numeric"
          min="1"
          max="100000"
          placeholder="Ex.: 90"
          required
        />
        <p class="campo__erro">Informe a metragem aproximada, em m².</p>
      </div>
    ) : ehRenderizacao ? (
      <div class="campo">
        <label for="mensagem">
          Sobre o projeto <span class="campo__opcional">(opcional)</span>
        </label>
        <textarea
          id="mensagem"
          name="mensagem"
          rows="4"
          maxlength="2000"
          placeholder="Ex.: casa de 200 m², 5 imagens internas e 2 externas, para o dia 10."
        />
      </div>
    ) : (
      <>
        <div class="campo">
          <label for="tipo">Tipo de projeto</label>
          <select id="tipo" name="tipo" required>
            <option value="" selected disabled>
              Escolha uma opção
            </option>
            {tipos.map((t) => (
              <option value={t}>{t}</option>
            ))}
          </select>
          <p class="campo__erro">Escolha o tipo de projeto.</p>
        </div>

        <div class="campo">
          <label for="mensagem">
            Mensagem <span class="campo__opcional">(opcional)</span>
          </label>
          <textarea id="mensagem" name="mensagem" rows="5" maxlength="2000" />
        </div>
      </>
    )
  }

  <div class="campo campo--aceite">
    <input id="aceite" name="aceite" type="checkbox" required />
    <label for="aceite">
      Concordo com a <a href="/privacidade" target="_blank">política de privacidade</a>.
    </label>
    <p class="campo__erro">É preciso concordar para enviar.</p>
  </div>

  {
    site.hcaptchaAtivo && (
      <div class="campo">
        {/* A caixinha do hCaptcha; o script do Web3Forms a transforma no desafio */}
        <div class="h-captcha" data-captcha="true" />
        <p class="campo__erro campo__erro--captcha" data-erro-captcha>
          Confirme que você não é um robô.
        </p>
        <script is:inline src="https://web3forms.com/client/script.js" async defer />
      </div>
    )
  }

  <p class="form__falha" role="alert" hidden data-falha>
    Não foi possível enviar agora. Tente de novo em instantes ou
    <a href={linkWhatsApp()} target="_blank" rel="noopener" data-whatsapp>fale pelo WhatsApp</a>.
  </p>

  <button class="form__enviar" type="submit" data-enviar>{textoBotao}</button>
</form>

<script>
  import { lerOrigem } from '../../lib/utm';

  // Máscara do WhatsApp: (81) 99999-9999 enquanto a pessoa digita
  document.querySelectorAll<HTMLInputElement>('[data-mascara-telefone]').forEach((campo) => {
    campo.addEventListener('input', () => {
      const d = campo.value.replace(/\D/g, '').slice(0, 11);
      let v = d;
      if (d.length > 2) v = `(${d.slice(0, 2)}) ${d.slice(2)}`;
      if (d.length > 6) v = `(${d.slice(0, 2)}) ${d.slice(2, d.length - 4)}-${d.slice(-4)}`;
      campo.value = v;
    });
  });

  const form = document.querySelector<HTMLFormElement>('[data-form-contato]');
  const botao = form?.querySelector<HTMLButtonElement>('[data-enviar]');
  const falha = form?.querySelector<HTMLElement>('[data-falha]');

  /** Marca os campos inválidos e devolve o primeiro, para receber o foco. */
  function validar(f: HTMLFormElement): HTMLElement | null {
    let primeiro: HTMLElement | null = null;
    f.querySelectorAll<HTMLInputElement>('.campo input, .campo select, .campo textarea').forEach((campo) => {
      const invalido = !campo.checkValidity();
      campo.closest('.campo')?.classList.toggle('campo--invalido', invalido);
      campo.setAttribute('aria-invalid', String(invalido));
      if (invalido && !primeiro) primeiro = campo;
    });
    return primeiro;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!botao || !falha) return;
    falha.hidden = true;

    const invalido = validar(form);
    if (invalido) {
      invalido.focus();
      return;
    }

    const chave = form.dataset.chave;
    if (!chave) {
      falha.hidden = false; // formulário ainda sem chave: orienta a usar o WhatsApp
      return;
    }

    // hCaptcha (só quando ligado em site.ts): exige que a pessoa tenha resolvido o desafio
    let tokenCaptcha: string | undefined;
    if (form.dataset.captcha) {
      tokenCaptcha =
        form.querySelector<HTMLTextAreaElement>('[name="h-captcha-response"]')?.value || undefined;
      const erroCaptcha = form.querySelector<HTMLElement>('[data-erro-captcha]');
      erroCaptcha?.classList.toggle('campo__erro--visivel', !tokenCaptcha);
      if (!tokenCaptcha) return;
    }

    const dados = new FormData(form);
    const origem = lerOrigem();
    const nome = String(dados.get('nome'));
    const campanha = form.dataset.campanha; // só nas landing pages
    const tipo = form.dataset.tipoFixo ?? String(dados.get('tipo'));

    // Campos que mudam conforme a variante do formulário
    // (metragem só existe na variante campanha; nas outras vai a mensagem)
    const metragem = dados.get('metragem');
    const especificos = {
      ...(metragem
        ? { Metragem: `${metragem} m²` }
        : { Mensagem: dados.get('mensagem') || '(sem mensagem)' }),
      ...(campanha ? { 'Landing page': campanha } : {}),
    };

    // O que chega no e-mail (cada campo vira uma linha)
    const corpo = {
      access_key: chave,
      subject: campanha
        ? `Novo contato da campanha ${campanha}: ${nome}`
        : `Novo contato pelo site: ${nome} (${tipo})`,
      from_name: 'Site Koovack Arquitetura',
      botcheck: (form.querySelector('[name="botcheck"]') as HTMLInputElement).checked,
      Nome: nome,
      WhatsApp: dados.get('whatsapp'),
      Cidade: dados.get('cidade'),
      'Tipo de projeto': tipo,
      ...especificos,
      'Página do formulário': window.location.pathname,
      'Página de entrada': origem.pagina_entrada ?? '(desconhecida)',
      'Origem (utm_source)': origem.utm_source ?? '(direto)',
      'Meio (utm_medium)': origem.utm_medium ?? '-',
      'Campanha (utm_campaign)': origem.utm_campaign ?? '-',
      'Conteúdo (utm_content)': origem.utm_content ?? '-',
      ...(tokenCaptcha ? { 'h-captcha-response': tokenCaptcha } : {}),
    };

    botao.disabled = true;
    botao.textContent = 'Enviando…';
    try {
      const resposta = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(corpo),
      });
      const json = await resposta.json();
      if (!resposta.ok || !json.success) throw new Error(json.message ?? 'falha no envio');
      window.location.href = '/obrigado';
    } catch {
      falha.hidden = false;
      botao.disabled = false;
      botao.textContent = form.dataset.textoBotao ?? 'Enviar mensagem';
    }
  });
</script>

<style>
  .form {
    display: flex;
    flex-direction: column;
    gap: var(--esp-4);
    max-width: 36rem;
  }
  .form__aviso,
  .form__falha {
    padding: var(--esp-3);
    border: 1px dashed currentColor;
    font-size: var(--texto-pequeno);
  }
  .form__falha {
    color: #a33a3a;
  }
  .form__falha[hidden] {
    display: none;
  }

  /* Fora da tela, mas existe no formulário (honeypot) */
  .form__isca {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .campo {
    display: flex;
    flex-direction: column;
    gap: var(--esp-1);
  }
  label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
  .campo__opcional {
    text-transform: none;
    letter-spacing: 0;
    opacity: 0.7;
  }
  input:not([type='checkbox']),
  select,
  textarea {
    width: 100%;
    min-height: 3rem;
    padding: var(--esp-2) var(--esp-3);
    border: 1px solid var(--cor-filete);
    border-radius: var(--raio);
    background: var(--cor-branco);
    font-size: 1rem; /* 16px evita o zoom automático do iPhone ao tocar no campo */
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: 2px solid var(--cor-principal);
    outline-offset: 0;
    border-color: transparent;
  }
  textarea {
    resize: vertical;
  }

  .campo--aceite {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--esp-2);
  }
  .campo--aceite input {
    width: 1.25rem;
    height: 1.25rem;
    accent-color: var(--cor-principal);
  }
  .campo--aceite label {
    flex: 1;
    font-size: var(--texto-pequeno);
    text-transform: none;
    letter-spacing: 0;
  }
  .campo--aceite .campo__erro {
    flex-basis: 100%;
  }

  .campo__erro {
    display: none;
    font-size: var(--texto-pequeno);
    color: #a33a3a;
  }
  .campo--invalido .campo__erro,
  .campo__erro--visivel {
    display: block;
  }
  .campo--invalido input,
  .campo--invalido select {
    border-color: #a33a3a;
  }

  .form__enviar {
    align-self: flex-start;
    min-height: 3.25rem;
    padding: 0 var(--esp-6);
    border: 1px solid var(--cor-principal);
    border-radius: var(--raio-botao);
    background: none;
    cursor: pointer;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    transition: background-color var(--transicao);
  }
  .form__enviar:hover {
    background: var(--cor-fundo-alt);
  }
  .form__enviar:disabled {
    opacity: 0.6;
    cursor: wait;
  }
</style>

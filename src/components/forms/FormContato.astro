---
// Formulário de contato (alternativa ao WhatsApp).
// FASE 4 (PROVISÓRIO): valida os campos e leva para /obrigado SEM ENVIAR NADA.
// Na fase 5 ele passa a enviar para o Web3Forms (e-mail do Diogo), com honeypot, hCaptcha e UTMs.
const tipos = ['Apartamento', 'Casa', 'Loja', 'Comercial', 'Outro'];
---

<form class="form" novalidate data-form-contato>
  <p class="form__aviso">
    Formulário em construção: por enquanto ele não envia a mensagem. Use o WhatsApp.
  </p>

  <div class="campo">
    <label for="nome">Nome</label>
    <input id="nome" name="nome" type="text" autocomplete="name" required />
    <p class="campo__erro" data-erro>Informe seu nome.</p>
  </div>

  <div class="campo">
    <label for="whatsapp">WhatsApp</label>
    <input
      id="whatsapp"
      name="whatsapp"
      type="tel"
      inputmode="numeric"
      autocomplete="tel-national"
      placeholder="(81) 99999-9999"
      pattern="\(\d{2}\) \d{4,5}-\d{4}"
      required
      data-mascara-telefone
    />
    <p class="campo__erro" data-erro>Informe um WhatsApp com DDD, ex.: (81) 99999-9999.</p>
  </div>

  <div class="campo">
    <label for="cidade">Cidade</label>
    <input id="cidade" name="cidade" type="text" autocomplete="address-level2" required />
    <p class="campo__erro" data-erro>Informe sua cidade.</p>
  </div>

  <div class="campo">
    <label for="tipo">Tipo de projeto</label>
    <select id="tipo" name="tipo" required>
      <option value="" selected disabled>Escolha uma opção</option>
      {tipos.map((t) => <option value={t}>{t}</option>)}
    </select>
    <p class="campo__erro" data-erro>Escolha o tipo de projeto.</p>
  </div>

  <div class="campo">
    <label for="mensagem">Mensagem <span class="campo__opcional">(opcional)</span></label>
    <textarea id="mensagem" name="mensagem" rows="5"></textarea>
  </div>

  <div class="campo campo--aceite">
    <input id="aceite" name="aceite" type="checkbox" required />
    <label for="aceite">
      Concordo com a <a href="/privacidade" target="_blank">política de privacidade</a>.
    </label>
    <p class="campo__erro" data-erro>É preciso concordar para enviar.</p>
  </div>

  <button class="form__enviar" type="submit">Enviar mensagem</button>
</form>

<script>
  // Máscara do WhatsApp: (81) 99999-9999 enquanto a pessoa digita
  document.querySelectorAll<HTMLInputElement>('[data-mascara-telefone]').forEach((campo) => {
    campo.addEventListener('input', () => {
      const d = campo.value.replace(/\D/g, '').slice(0, 11);
      let v = d;
      if (d.length > 2) v = `(${d.slice(0, 2)}) ${d.slice(2)}`;
      if (d.length > 6) v = `(${d.slice(0, 2)}) ${d.slice(2, d.length - 4)}-${d.slice(-4)}`;
      campo.value = v;
    });
  });

  // Validação: mostra a mensagem de erro embaixo de cada campo inválido
  const form = document.querySelector<HTMLFormElement>('[data-form-contato]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    let primeiroInvalido: HTMLElement | null = null;
    form.querySelectorAll<HTMLInputElement>('input, select, textarea').forEach((campo) => {
      const invalido = !campo.checkValidity();
      campo.closest('.campo')?.classList.toggle('campo--invalido', invalido);
      campo.setAttribute('aria-invalid', String(invalido));
      if (invalido && !primeiroInvalido) primeiroInvalido = campo;
    });
    if (primeiroInvalido) {
      (primeiroInvalido as HTMLElement).focus();
      return;
    }
    // PROVISÓRIO (fase 4): não envia nada, só segue para a página de agradecimento.
    window.location.href = '/obrigado';
  });
</script>

<style>
  .form {
    display: flex;
    flex-direction: column;
    gap: var(--esp-4);
    max-width: 36rem;
  }
  .form__aviso {
    padding: var(--esp-3);
    border: 1px dashed currentColor;
    font-size: var(--texto-pequeno);
  }

  .campo {
    display: flex;
    flex-direction: column;
    gap: var(--esp-1);
  }
  label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
  .campo__opcional {
    text-transform: none;
    letter-spacing: 0;
    opacity: 0.7;
  }
  input:not([type='checkbox']),
  select,
  textarea {
    width: 100%;
    min-height: 3rem;
    padding: var(--esp-2) var(--esp-3);
    border: 1px solid var(--cor-filete);
    border-radius: var(--raio);
    background: var(--cor-branco);
    font-size: 1rem; /* 16px evita o zoom automático do iPhone ao tocar no campo */
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: 2px solid var(--cor-principal);
    outline-offset: 0;
    border-color: transparent;
  }
  textarea {
    resize: vertical;
  }

  .campo--aceite {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--esp-2);
  }
  .campo--aceite input {
    width: 1.25rem;
    height: 1.25rem;
    accent-color: var(--cor-principal);
  }
  .campo--aceite label {
    flex: 1;
    font-size: var(--texto-pequeno);
    text-transform: none;
    letter-spacing: 0;
  }
  .campo--aceite .campo__erro {
    flex-basis: 100%;
  }

  .campo__erro {
    display: none;
    font-size: var(--texto-pequeno);
    color: #a33a3a;
  }
  .campo--invalido .campo__erro {
    display: block;
  }
  .campo--invalido input,
  .campo--invalido select {
    border-color: #a33a3a;
  }

  .form__enviar {
    align-self: flex-start;
    min-height: 3.25rem;
    padding: 0 var(--esp-6);
    border: 1px solid var(--cor-principal);
    border-radius: var(--raio-botao);
    background: none;
    cursor: pointer;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    transition: background-color var(--transicao);
  }
  .form__enviar:hover {
    background: var(--cor-fundo-alt);
  }
</style>

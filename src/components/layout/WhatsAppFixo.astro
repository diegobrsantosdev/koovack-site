---
// Botão de WhatsApp fixo na base da tela.
// Celular: barra de largura total. Desktop: botão flutuante no canto inferior direito.
import { site } from '../../config/site';
import { linkWhatsApp, atributosRastreio, type RastreioWhatsApp } from '../../lib/whatsapp';
import IconeWhatsApp from '../ui/IconeWhatsApp.astro';

interface Props {
  mensagem?: string; // mensagem pré-preenchida; sem ela, usa a geral
  rastreio?: RastreioWhatsApp;
  detalhe?: string; // segunda linha, menor (ex.: o serviço escolhido em Formas de trabalhar)
}

const { mensagem, rastreio, detalhe } = Astro.props;
---

<a
  class="whatsapp-fixo"
  href={linkWhatsApp(mensagem)}
  target="_blank"
  rel="noopener"
  {...atributosRastreio(rastreio)}
>
  <IconeWhatsApp />
  <span class="whatsapp-fixo__textos">
    <span>{site.textoBotaoWhatsApp}<span class="sr-only"> {site.complementoAcessivelWhatsApp}</span></span>
    <span class="whatsapp-fixo__detalhe" data-whatsapp-detalhe hidden={!detalhe}>{detalhe}</span>
  </span>
</a>

<script>
  // Se a página tiver uma área com o próprio botão de WhatsApp (ex.: o slideshow da home,
  // marcado com data-esconde-whatsapp-fixo), o botão fixo some enquanto essa área estiver
  // visível, para não aparecerem dois botões iguais ao mesmo tempo.
  // Pode haver mais de uma área assim na página (ex.: home tem o slideshow e o seletor de serviços):
  // o botão fica oculto enquanto QUALQUER uma delas estiver visível.
  const botao = document.querySelector<HTMLElement>('.whatsapp-fixo');
  const areas = [...document.querySelectorAll('[data-esconde-whatsapp-fixo]')];
  if (botao && areas.length) {
    const visiveis = new Set<Element>();
    const observador = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((e) => (e.isIntersecting ? visiveis.add(e.target) : visiveis.delete(e.target)));
        botao.classList.toggle('whatsapp-fixo--oculto', visiveis.size > 0);
      },
      { threshold: 0.35 },
    );
    areas.forEach((area) => observador.observe(area));
  }
</script>

<style>
  .whatsapp-fixo {
    position: fixed;
    z-index: 40;
    left: var(--esp-3);
    right: var(--esp-3);
    bottom: calc(var(--esp-3) + env(safe-area-inset-bottom, 0px)); /* respeita a barra do iPhone */
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--esp-2);
    min-height: var(--altura-whatsapp-fixo);
    padding: 0 var(--esp-4);
    border-radius: var(--raio-botao);
    background: var(--cor-principal);
    color: var(--cor-branco);
    border: 1px solid rgb(255 255 255 / 0.35); /* separa o botão do rodapé, que tem a mesma cor */
    text-decoration: none;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap; /* o texto cabe numa linha só, mesmo em 360 px */
    box-shadow: 0 6px 20px rgb(62 78 104 / 0.28);
    transition: background-color var(--transicao), transform var(--transicao), opacity var(--transicao),
      visibility 0s;
  }

  .whatsapp-fixo--oculto {
    opacity: 0;
    visibility: hidden; /* também sai da navegação por teclado */
    transform: translateY(1rem);
    transition: opacity var(--transicao), transform var(--transicao), visibility 0s linear 200ms;
  }

  .whatsapp-fixo:hover {
    background: var(--cor-principal-escura);
  }

  .whatsapp-fixo__textos {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.25;
  }
  .whatsapp-fixo__detalhe {
    font-size: 0.75rem;
    text-transform: none;
    letter-spacing: 0.02em;
    opacity: 0.85;
  }
  .whatsapp-fixo__detalhe[hidden] {
    display: none;
  }

  .whatsapp-fixo:focus-visible {
    outline-color: var(--cor-detalhe);
  }

  @media (min-width: 48rem) {
    .whatsapp-fixo {
      left: auto;
      right: var(--esp-5);
      bottom: var(--esp-5);
      font-size: var(--texto-pequeno);
      letter-spacing: 0.12em;
    }
    .whatsapp-fixo:hover {
      transform: translateY(-2px);
    }
  }
</style>

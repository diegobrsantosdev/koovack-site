---
// Botão de WhatsApp fixo na base da tela.
// Celular: barra de largura total. Desktop: botão flutuante no canto inferior direito.
import { site } from '../../config/site';
import { linkWhatsApp } from '../../lib/whatsapp';

interface Props {
  mensagem?: string; // mensagem pré-preenchida; sem ela, usa a geral
}

const { mensagem } = Astro.props;
---

<a
  class="whatsapp-fixo"
  href={linkWhatsApp(mensagem)}
  target="_blank"
  rel="noopener"
>
  <svg class="whatsapp-fixo__icone" viewBox="0 0 24 24" aria-hidden="true">
    <path
      d="M12 3.5a8.5 8.5 0 0 0-7.3 12.8L3.5 20.5l4.3-1.1A8.5 8.5 0 1 0 12 3.5Z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linejoin="round"></path>
    <path
      d="M9.2 8.3c.2-.4.4-.4.6-.4h.5c.2 0 .4 0 .5.4l.7 1.6c.1.2 0 .4-.1.5l-.5.6c-.1.1-.1.3 0 .5.6 1 1.4 1.8 2.4 2.3.2.1.4.1.5 0l.6-.6c.2-.2.3-.2.5-.1l1.6.8c.2.1.3.2.3.4 0 .5-.2 1.2-.7 1.5-.5.3-1.2.5-2.4.1a8.7 8.7 0 0 1-4.6-4.4c-.5-1.1-.3-2.4.1-3.2Z"
      fill="currentColor"></path>
  </svg>
  <span>{site.textoBotaoWhatsApp}</span>
</a>

<style>
  .whatsapp-fixo {
    position: fixed;
    z-index: 40;
    left: var(--esp-3);
    right: var(--esp-3);
    bottom: calc(var(--esp-3) + env(safe-area-inset-bottom, 0px)); /* respeita a barra do iPhone */
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--esp-2);
    min-height: var(--altura-whatsapp-fixo);
    padding: 0 var(--esp-4);
    border-radius: var(--raio-botao);
    background: var(--cor-principal);
    color: var(--cor-branco);
    border: 1px solid rgb(255 255 255 / 0.35); /* separa o botão do rodapé, que tem a mesma cor */
    text-decoration: none;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap; /* o texto cabe numa linha só, mesmo em 360 px */
    box-shadow: 0 6px 20px rgb(62 78 104 / 0.28);
    transition: background-color var(--transicao), transform var(--transicao);
  }

  .whatsapp-fixo:hover {
    background: var(--cor-principal-escura);
  }

  .whatsapp-fixo:focus-visible {
    outline-color: var(--cor-detalhe);
  }

  .whatsapp-fixo__icone {
    width: 1.375rem;
    height: 1.375rem;
    flex-shrink: 0;
  }

  @media (min-width: 48rem) {
    .whatsapp-fixo {
      left: auto;
      right: var(--esp-5);
      bottom: var(--esp-5);
      font-size: var(--texto-pequeno);
      letter-spacing: 0.12em;
    }
    .whatsapp-fixo:hover {
      transform: translateY(-2px);
    }
  }
</style>

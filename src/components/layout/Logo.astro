---
// PROVISÓRIO: logo só em texto até chegar o arquivo SVG da direção 2 (empilhada).
// Quando o SVG chegar em src/assets/marca/, este componente passa a renderizar a imagem.
import { site } from '../../config/site';
---

<a href="/" class="logo" aria-label={`${site.nome}, página inicial`}>
  <span class="logo__nome">Koovack</span>
  <span class="logo__sub">Arquitetura</span>
</a>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    font-family: var(--fonte-titulo);
    text-transform: uppercase;
    line-height: 1;
    color: var(--cor-principal);
  }
  .logo__nome {
    font-size: 1.25rem;
    letter-spacing: 0.22em;
    margin-right: -0.22em; /* compensa o espaçamento da última letra para centralizar */
  }
  .logo__sub {
    margin-top: 0.3rem;
    font-size: 0.625rem;
    letter-spacing: 0.42em;
    margin-right: -0.42em;
    color: var(--cor-detalhe);
  }
</style>

---
// Card completo de uma forma de trabalhar: para quem é, o que inclui e o botão de WhatsApp
// com a mensagem já citando o serviço. O id do card permite links diretos (/formas-de-trabalhar#consultoria).
import type { CollectionEntry } from 'astro:content';
import Etiqueta from '../ui/Etiqueta.astro';
import BotaoWhatsApp from '../ui/BotaoWhatsApp.astro';
import { mensagemServico } from '../../lib/whatsapp';

interface Props {
  servico: CollectionEntry<'servicos'>;
}
const { servico } = Astro.props;
const s = servico.data;
---

<article class:list={['card', { 'card--recomendado': s.recomendado }]} id={servico.id}>
  {
    s.recomendado && (
      <span class="card__etiqueta">
        <Etiqueta variante="solida">Recomendado</Etiqueta>
      </span>
    )
  }
  <h2 class="card__nome">{s.nome}</h2>

  <div class="card__bloco">
    <h3>Para quem é</h3>
    <p>{s.para_quem}</p>
  </div>

  <div class="card__bloco">
    <h3>O que inclui</h3>
    <ul class="card__inclui">
      {s.inclui.map((item) => <li>{item}</li>)}
    </ul>
  </div>

  {s.online && <p class="card__online">Disponível online, para todo o Brasil</p>}

  <BotaoWhatsApp mensagem={mensagemServico(s.nome)} rastreio={{ servico: s.nome }} />
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--esp-4);
    padding: var(--esp-6) var(--esp-3) var(--esp-5);
    border: 1px solid var(--cor-filete);
    border-radius: var(--raio);
    background: var(--cor-branco);
    scroll-margin-top: calc(var(--altura-header) + var(--esp-4)); /* o header não cobre o card no link direto */
  }
  .card--recomendado {
    border-color: var(--cor-principal);
    box-shadow: 0 8px 24px rgb(62 78 104 / 0.12);
  }
  .card__etiqueta {
    position: absolute;
    top: 0;
    left: var(--esp-3);
    transform: translateY(-50%);
  }
  .card__nome {
    font-size: clamp(1.25rem, 1.1rem + 0.8vw, 1.75rem);
  }
  .card__bloco {
    display: flex;
    flex-direction: column;
    gap: var(--esp-2);
  }
  .card__bloco h3 {
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    opacity: 0.75;
  }
  .card__inclui {
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: var(--esp-1);
  }
  .card__inclui li::marker {
    color: var(--cor-detalhe);
  }
  .card__online {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
  @media (min-width: 48rem) {
    .card {
      padding-inline: var(--esp-6);
    }
    .card__etiqueta {
      left: var(--esp-6);
    }
  }
</style>

---
// Card de uma forma de trabalhar, SELECIONÁVEL: tocar no card escolhe aquela opção.
// Por baixo é um <input type="radio"> (escondido): funciona com teclado (setas) e leitor de tela.
// A escolha atualiza o botão de WhatsApp da página (ver formas-de-trabalhar.astro).
// O id do card permite links diretos (/formas-de-trabalhar#consultoria), que já chegam selecionando.
import type { CollectionEntry } from 'astro:content';
import Etiqueta from '../ui/Etiqueta.astro';

interface Props {
  servico: CollectionEntry<'servicos'>;
  selecionado?: boolean;
  compacto?: boolean; // versão da home: sem a lista "O que inclui"
}
const { servico, selecionado = false, compacto = false } = Astro.props;
const s = servico.data;
---

<label
  class:list={['card', { 'card--recomendado': s.recomendado, 'card--compacto': compacto }]}
  id={compacto ? undefined : servico.id}
  data-servico-id={servico.id}
>
  <input
    class="card__radio"
    type="radio"
    name="servico"
    value={s.nome}
    checked={selecionado}
    data-servico-opcao
  />
  {
    s.recomendado && (
      <span class="card__etiqueta">
        <Etiqueta variante="solida">Recomendado</Etiqueta>
      </span>
    )
  }
  <span class="card__marca" aria-hidden="true">
    <svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
  </span>

  <span class="card__nome">{s.nome}</span>

  <span class="card__bloco">
    {!compacto && <span class="card__subtitulo">Para quem é</span>}
    <span class="card__para-quem">{s.para_quem}</span>
  </span>

  {
    !compacto && (
      <span class="card__bloco">
        <span class="card__subtitulo">O que inclui</span>
        <span class="card__inclui">
          {s.inclui.map((item) => (
            <span class="card__item">{item}</span>
          ))}
        </span>
      </span>
    )
  }

  {
    s.online && (
      <span class="card__online">
        {compacto ? 'Também online, para todo o Brasil' : 'Disponível online, para todo o Brasil'}
      </span>
    )
  }
</label>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--esp-4);
    padding: var(--esp-6) var(--esp-3) var(--esp-5);
    border: 1px solid var(--cor-filete);
    border-radius: var(--raio);
    background: var(--cor-branco);
    cursor: pointer;
    scroll-margin-top: calc(var(--altura-header) + var(--esp-4)); /* o header não cobre o card no link direto */
    transition: border-color var(--transicao), box-shadow var(--transicao);
  }
  .card:hover {
    border-color: var(--cor-principal);
  }

  /* O radio existe, mas fica invisível: o card inteiro é a área de clique */
  .card__radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  /* Selecionado: borda mais forte, sombra e marca preenchida */
  .card:has(.card__radio:checked) {
    border-color: var(--cor-principal);
    box-shadow:
      0 0 0 1px var(--cor-principal),
      0 10px 28px rgb(62 78 104 / 0.14);
  }
  /* Foco pelo teclado (setas/Tab) */
  .card:has(.card__radio:focus-visible) {
    outline: 2px solid var(--cor-principal);
    outline-offset: 4px;
  }

  /* Marca no canto: círculo vazio (não escolhido) ou preenchido com ✓ (escolhido) */
  .card__marca {
    position: absolute;
    top: var(--esp-4);
    right: var(--esp-4);
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--cor-filete);
    border-radius: 50%;
    color: var(--cor-branco);
    transition: background-color var(--transicao), border-color var(--transicao);
  }
  .card__marca svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    opacity: 0;
  }
  .card:has(.card__radio:checked) .card__marca {
    background: var(--cor-principal);
    border-color: var(--cor-principal);
  }
  .card:has(.card__radio:checked) .card__marca svg {
    opacity: 1;
  }

  .card__etiqueta {
    position: absolute;
    top: 0;
    left: var(--esp-3);
    transform: translateY(-50%);
  }
  .card__nome {
    padding-right: var(--esp-6); /* não encosta na marca do canto */
    font-size: clamp(1.25rem, 1.1rem + 0.8vw, 1.75rem);
    font-weight: var(--peso-titulo);
    text-transform: uppercase;
    letter-spacing: var(--espacamento-titulo);
    line-height: 1.3;
  }
  .card__bloco {
    display: flex;
    flex-direction: column;
    gap: var(--esp-2);
  }
  .card__subtitulo {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    opacity: 0.75;
  }
  .card__inclui {
    display: flex;
    flex-direction: column;
    gap: var(--esp-1);
  }
  .card__item {
    position: relative;
    padding-left: 1.1rem;
  }
  .card__item::before {
    content: '';
    position: absolute;
    left: 0.2rem;
    top: 0.7em;
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--cor-detalhe);
  }
  .card__online {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  /* Versão compacta (home): menor, para caber 4 lado a lado no desktop */
  .card.card--compacto {
    gap: var(--esp-3);
    padding: var(--esp-5) var(--esp-3) var(--esp-4);
  }
  .card--compacto .card__nome {
    font-size: var(--texto-grande);
    font-weight: 400;
    letter-spacing: 0.14em;
  }
  .card--compacto .card__para-quem {
    font-size: var(--texto-pequeno);
  }
  .card--compacto .card__bloco {
    flex: 1;
  }
  .card.card--compacto .card__marca {
    top: var(--esp-3);
    right: var(--esp-3);
    width: 1.5rem;
    height: 1.5rem;
  }

  @media (min-width: 48rem) {
    .card {
      padding-inline: var(--esp-6);
    }
    .card__etiqueta {
      left: var(--esp-6);
    }
    .card__marca {
      right: var(--esp-5);
    }
  }
</style>

---
// Perguntas frequentes em "sanfona": toca na pergunta e a resposta abre.
// Usa <details>/<summary>, que funciona sem JavaScript e com teclado.
// `pagina` escolhe quais perguntas aparecem (campo `paginas` de cada item do FAQ).
import { getCollection } from 'astro:content';
import type { PAGINAS_FAQ } from '../../content.config';

interface Props {
  pagina: (typeof PAGINAS_FAQ)[number];
}
const { pagina } = Astro.props;

const perguntas = (await getCollection('faq'))
  .filter((f) => f.data.paginas.includes(pagina))
  .sort((a, b) => a.data.ordem - b.data.ordem);
---

<div class="faq">
  {
    perguntas.map((f) => (
      <details class="faq__item">
        <summary>
          <span>{f.data.pergunta}</span>
          <span class="faq__icone" aria-hidden="true" />
        </summary>
        <p>{f.data.resposta}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--cor-filete);
  }
  .faq__item {
    border-bottom: 1px solid var(--cor-filete);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--esp-3);
    min-height: 3.5rem;
    padding-block: var(--esp-3);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  /* "+" que vira "−" quando abre */
  .faq__icone {
    position: relative;
    flex-shrink: 0;
    width: 0.875rem;
    height: 0.875rem;
  }
  .faq__icone::before,
  .faq__icone::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transition: transform var(--transicao);
  }
  .faq__icone::after {
    transform: rotate(90deg);
  }
  details[open] .faq__icone::after {
    transform: rotate(0deg);
  }
  .faq__item p {
    max-width: 40rem;
    padding-bottom: var(--esp-4);
  }
</style>

---
// Faixa logo abaixo do slideshow: as áreas de atuação, separadas por filetes.
import { site } from '../../config/site';
---

<div class="faixa">
  <ul class="container faixa__lista">
    {site.areas.map((area) => <li>{area}</li>)}
  </ul>
</div>

<style>
  .faixa {
    border-bottom: 1px solid var(--cor-filete);
  }
  .faixa__lista {
    list-style: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: var(--esp-4);
    font-size: var(--texto-pequeno);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    text-align: center;
  }
  .faixa__lista li {
    padding-block: var(--esp-2);
  }
  .faixa__lista li + li {
    border-top: 1px solid var(--cor-filete);
    width: 16rem;
  }

  @media (min-width: 48rem) {
    .faixa__lista {
      flex-direction: row;
      justify-content: center;
    }
    .faixa__lista li {
      padding: 0 var(--esp-5);
    }
    .faixa__lista li + li {
      border-top: 0;
      border-left: 1px solid var(--cor-filete);
      width: auto;
    }
  }
</style>

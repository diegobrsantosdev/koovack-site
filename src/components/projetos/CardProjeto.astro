---
// Card de projeto para a grade da página Projetos: capa, tipo, nome e cidade.
import { Picture } from 'astro:assets';
import type { Projeto } from '../../lib/projetos';
import { ROTULO_TIPO, formatarArea } from '../../lib/projetos';

interface Props {
  projeto: Projeto;
}
const { projeto } = Astro.props;
const p = projeto.data;
---

<a class="card" href={`/projetos/${projeto.id}`}>
  <div class="card__imagem">
    <Picture
      src={p.capa.imagem}
      alt={p.capa.alt}
      formats={['avif', 'webp']}
      widths={[480, 800, 1200]}
      sizes="(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw"
      loading="lazy"
    />
  </div>
  <span class="card__tipo">{ROTULO_TIPO[p.tipo]}</span>
  <h3 class="card__titulo">{p.titulo}</h3>
  <span class="card__dados">{p.cidade} · {formatarArea(p.area_m2)}</span>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--esp-1);
    text-decoration: none;
  }
  .card__imagem {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    margin-bottom: var(--esp-2);
    background: var(--cor-fundo-alt);
  }
  .card__imagem :global(picture),
  .card__imagem :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms ease;
  }
  .card:hover .card__imagem :global(img) {
    transform: scale(1.03);
  }
  .card__tipo,
  .card__dados {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    opacity: 0.8;
  }
  .card__titulo {
    font-size: var(--texto-grande);
    font-weight: 300;
    letter-spacing: 0.14em;
  }
</style>
